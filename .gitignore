# ============================================================
# Go build artifacts
# ============================================================
# Compiled binaries (default names produced by `go build` at repo root)
/misol-hp3001-exporter-go
/misol-hp3001-exporter-go.exe

# Project-specific output directory (see build_all_with_ver.cmd)
/build/

# Test binaries
*.test
*.out

# Coverage output
coverage.txt
coverage.html
*.cover
*.coverprofile
profile.cov

# Go workspace file (Go 1.18+)
go.work
go.work.sum

# Go module cache / vendor should NOT be ignored — vendor/ is committed
# if used. Uncomment the next line only if you intentionally vendored
# dependencies and want to exclude them (unusual).
# /vendor/

# ============================================================
# Runtime files produced by the exporter
# ============================================================
# Log files (--error-log logs/error.log)
/logs/
*.log

# ============================================================
# Editors / IDEs
# ============================================================
