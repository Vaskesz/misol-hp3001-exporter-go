.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.vscode/.history/
.history/

# JetBrains (GoLand, IntelliJ IDEA)
.idea/
*.iml
*.ipr
*.iws

# Visual Studio / VS Code C# artifacts (harmless if unused)
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Vim / Neovim
*.swp
*.swo
*.swn
*~
.netrwhist
.vim/

# Emacs
*~
\#*\#
.\#*

